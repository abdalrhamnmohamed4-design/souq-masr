# .env.example — انسخه لـ.env محلي (متتشيّلش .env نفسها فـgit) عشان
# تظبط بيئة التشغيل. شوف config/env.ts وVERSION_CONTROL.md's §4/§13
# لتفاصيل كل قيمة.

# development | staging | production — لو سبتها فاضية، بيتحدد تلقائيًا:
# __DEV__ (npx expo start) = development، أي بناء تاني = production.
EXPO_PUBLIC_APP_ENV=development

# رابط Frappe bench الحقيقي (مفيش قيمة افتراضية عمدًا). لو فاضي في
# development، الاتصال بالباك إند بيتحاكى محليًا (lib/mockAppVersionConfig.ts)
# بدل ما يحاول يتصل بحاجة مش موجودة. لو فاضي في staging/production،
# التطبيق هيعرض شاشة "مفيش اتصال بالسيرفر" بصدق بدل أي افتراض.
# مثال: EXPO_PUBLIC_API_BASE_URL=https://souqmasr.frappe.cloud
EXPO_PUBLIC_API_BASE_URL=
