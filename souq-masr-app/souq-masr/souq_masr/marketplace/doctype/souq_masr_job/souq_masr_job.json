    { "fieldname": "title", "label": "Title", "fieldtype": "Data", "reqd": 1, "in_list_view": 1 },
    { "fieldname": "category_key", "label": "Category Key", "fieldtype": "Data", "reqd": 1, "in_standard_filter": 1, "description": "Client-side constant id from mock/jobs/categories.ts — Jobs uses its own flat category/profession list, deliberately NOT the marketplace taxonomy tree (a different domain, per that file's own comment). No server-side taxonomy DocType for this — just a non-empty string, validated for presence only." },
    { "fieldname": "profession_key", "label": "Profession Key", "fieldtype": "Data" },
    { "fieldname": "work_type", "label": "Work Type", "fieldtype": "Select", "options": "full_time\npart_time\nremote\nhybrid\nfreelance\ncontract\ntemporary\ninternship", "reqd": 1, "in_standard_filter": 1 },
    { "fieldname": "career_level", "label": "Career Level", "fieldtype": "Select", "options": "\nintern\nentry\njunior\nmid\nsenior\nmanager\ndirector\nexecutive" },
    { "fieldname": "city", "label": "City", "fieldtype": "Data", "in_standard_filter": 1 },
    { "fieldname": "area", "label": "Area", "fieldtype": "Data" },
    { "fieldname": "location_key", "label": "Location Key", "fieldtype": "Data", "description": "Validated against the REAL marketplace taxonomy (Souq Masr Location) when provided — locations ARE shared/reused across Jobs and Listings, unlike categories." },
    { "fieldname": "remote", "label": "Remote", "fieldtype": "Check" },
    { "fieldname": "salary_min", "label": "Salary Min", "fieldtype": "Int" },
    { "fieldname": "salary_max", "label": "Salary Max", "fieldtype": "Int" },
    { "fieldname": "salary_hidden", "label": "Salary Hidden", "fieldtype": "Check" },
    { "fieldname": "experience_years_min", "label": "Experience Years Min", "fieldtype": "Int" },
    { "fieldname": "experience_years_max", "label": "Experience Years Max", "fieldtype": "Int" },
    { "fieldname": "description", "label": "Description", "fieldtype": "Text" },
    { "fieldname": "responsibilities_json", "label": "Responsibilities (JSON)", "fieldtype": "Long Text", "description": "JSON-encoded array of plain strings — an intentional exception to this app's 'normalized, not JSON blob' rule: that rule targets STRUCTURED multi-field records (like Listing Images/Attribute Values), not a flat list of strings with no other fields, where a child DocType would add nothing but overhead." },
    { "fieldname": "requirements_json", "label": "Requirements (JSON)", "fieldtype": "Long Text" },
    { "fieldname": "skills_json", "label": "Skills (JSON)", "fieldtype": "Long Text" },
    { "fieldname": "benefits_json", "label": "Benefits (JSON)", "fieldtype": "Long Text" },
    { "fieldname": "application_method", "label": "Application Method", "fieldtype": "Select", "options": "in_app\nexternal_url\nemail", "default": "in_app" },
    { "fieldname": "application_url", "label": "Application URL", "fieldtype": "Data" },
    { "fieldname": "application_email", "label": "Application Email", "fieldtype": "Data" },
    { "fieldname": "deadline", "label": "Deadline", "fieldtype": "Date" },
    { "fieldname": "status", "label": "Status", "fieldtype": "Select", "options": "draft\npublished\npaused\nclosed\nexpired\nrejected", "default": "published", "in_standard_filter": 1 },
    { "fieldname": "is_urgent", "label": "Is Urgent", "fieldtype": "Check" },
    { "fieldname": "views", "label": "Views", "fieldtype": "Int", "default": "0" },
    { "fieldname": "applications_count", "label": "Applications Count", "fieldtype": "Int", "default": "0" }
  ],
  "permissions": [
    { "role": "Souq Masr Admin", "read": 1, "write": 1, "create": 1, "delete": 1, "export": 1, "report": 1 },
