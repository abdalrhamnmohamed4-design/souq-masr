  "fields": [
    { "fieldname": "conversation", "label": "Conversation", "fieldtype": "Link", "options": "Souq Masr Conversation", "reqd": 1, "in_standard_filter": 1 },
    { "fieldname": "caller", "label": "Caller", "fieldtype": "Link", "options": "User", "reqd": 1, "description": "Always frappe.session.user at start_call time — never client-supplied." },
    { "fieldname": "callee", "label": "Callee", "fieldtype": "Link", "options": "User", "reqd": 1, "description": "Derived server-side from the conversation's other participant — never a client-supplied id (prevents calling an arbitrary user by manipulating ids)." },
    { "fieldname": "listing", "label": "Listing", "fieldtype": "Link", "options": "Souq Masr Listing", "description": "Denormalized from conversation.listing for convenient querying." },
    { "fieldname": "call_type", "label": "Call Type", "fieldtype": "Select", "options": "voice", "default": "voice" },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Ringing\nActive\nEnded\nDeclined\nMissed\nCancelled\nFailed",
      "default": "Ringing",
      "reqd": 1,
      "in_standard_filter": 1
    },
    { "fieldname": "started_at", "label": "Started At", "fieldtype": "Datetime", "reqd": 1 },
    { "fieldname": "answered_at", "label": "Answered At", "fieldtype": "Datetime" },
    { "fieldname": "ended_at", "label": "Ended At", "fieldtype": "Datetime" },
    { "fieldname": "duration", "label": "Duration (seconds)", "fieldtype": "Int", "description": "answered_at to ended_at, computed server-side on end_call — only set for calls that actually reached Active." }
  ],
  "permissions": [
